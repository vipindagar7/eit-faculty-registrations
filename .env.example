# ── MongoDB ────────────────────────────────────────────────
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="faculty_registration"

# Registration ID prefix → BSE-0001, BSE-0002 …
REG_ID_PREFIX="BSE"

# ── OTP ────────────────────────────────────────────────────
# Long random string (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
OTP_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# saakshi = Saakshi Software bulk SMS gateway (production)
# console = OTP printed in terminal + shown as toast (dev only, blocked in production)
SMS_PROVIDER="saakshi"
SMS_USER="your-sms-username"
SMS_PASS="your-sms-password"
SENDER_ID="EITFBD"
# Optional override
# SMS_API_URL="http://bulksms.saakshisoftware.in/api/mt/SendSMS"

# ── Google Sheets (service account) ────────────────────────
# 1. Google Cloud → enable "Google Sheets API" → create Service Account → JSON key
# 2. Share your sheet with the service account email as Editor
GOOGLE_SERVICE_ACCOUNT_EMAIL="registrations@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz"
# Tab name inside the spreadsheet (must exist)
GOOGLE_SHEET_TAB="Registrations"
